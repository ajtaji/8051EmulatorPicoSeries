; Forum 1393: 16-bit unsigned comparisons. Generated by the compiler's tools/unsigned_cmp_check.py
; (its program() at compiler b86f45bd7); the expected values are that tool's, computed in Python.
EnableExplicit
Dim vals.u[8]
Dim ri.w[8]
Dim rv.w[8]
Global ja.w
Global nb.w
Global acc.w
Global acv.w
Global x.u
Global y.u
Global s.w
Global c.a
Global w1.w
Global w2.w
Global l1.w
Global l2.w
Global l3.w
Global l4.w
Global l5.w
Global l6.w
Global m1.w
Global m2.w
Global m3.w
Global m4.w
Global m5.w

Procedure.w CmpIf(a.u, b.u)
  Protected m.w = 0
  If a < b
    m = m | 1
  EndIf
  If a > b
    m = m | 2
  EndIf
  If a <= b
    m = m | 4
  EndIf
  If a >= b
    m = m | 8
  EndIf
  If a = b
    m = m | 16
  EndIf
  If a <> b
    m = m | 32
  EndIf
  ProcedureReturn m
EndProcedure

Procedure.w CmpVal(a.u, b.u)
  Protected m.w = 0
  Protected t.w
  t = (a < b)
  m = m | (t << 0)
  t = (a > b)
  m = m | (t << 1)
  t = (a <= b)
  m = m | (t << 2)
  t = (a >= b)
  m = m | (t << 3)
  t = (a = b)
  m = m | (t << 4)
  t = (a <> b)
  m = m | (t << 5)
  ProcedureReturn m
EndProcedure

Procedure Main()
  vals[0] = 0
  vals[1] = 1
  vals[2] = 255
  vals[3] = 256
  vals[4] = 32767
  vals[5] = 32768
  vals[6] = 40000
  vals[7] = 65535
  ja = 0
  While ja < 8
    acc = 0
    acv = 0
    nb = 0
    While nb < 8
      acc = acc + (CmpIf(vals[ja], vals[nb]) << nb)
      acv = acv + (CmpVal(vals[ja], vals[nb]) << nb)
      nb = nb + 1
    Wend
    ri[ja] = acc
    rv[ja] = acv
    ja = ja + 1
  Wend
  x = 30000
  y = 50000
  w1 = 0
  While x < y
    x = x + 10000
    w1 = w1 + 1
  Wend
  x = 20000
  w2 = 0
  Repeat
    x = x + 10000
    w2 = w2 + 1
  Until x >= 50000
  x = 30000
  If x < 40000
    l1 = 1
  Else
    l1 = 0
  EndIf
  x = 30000
  If x > 40000
    l2 = 1
  Else
    l2 = 0
  EndIf
  x = 30000
  If 300 > x
    l3 = 1
  Else
    l3 = 0
  EndIf
  x = 40000
  If 50000 > x
    l4 = 1
  Else
    l4 = 0
  EndIf
  x = 32768
  If x >= 32768
    l5 = 1
  Else
    l5 = 0
  EndIf
  x = 32768
  If x <= 32767
    l6 = 1
  Else
    l6 = 0
  EndIf
  s = -1
  y = 65535
  If s < y
    m1 = 1
  Else
    m1 = 0
  EndIf
  s = -1
  y = 0
  If s > y
    m2 = 1
  Else
    m2 = 0
  EndIf
  s = 40000
  y = -2
  If y > s
    m3 = 1
  Else
    m3 = 0
  EndIf
  s = 300
  y = 40000
  If s >= y
    m4 = 1
  Else
    m4 = 0
  EndIf
  c = 200
  y = 199
  If c > y
    m5 = 1
  Else
    m5 = 0
  EndIf
EndProcedure
