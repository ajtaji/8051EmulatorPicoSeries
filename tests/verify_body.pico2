; Verification: API checks, single-instruction vectors, compiled programs and
; interrupt/timer/serial programs. Shared by the board builds (verify*.picow,
; with verify_main.pico) and the desktop program, which includes it as PureBasic.
Global Cursor.i, CaseIndex.i, Failures.i, CaseFail.i, Shown.i, PassCount.i
Global VSeed.i, VPC.i, VLen.i, VAcc.i, VB.i, VPsw.i, VSP.i, VDpl.i, VDph.i
Global EPC.i, EAcc.i, EB.i, EPsw.i, ESP.i, EDpl.i, EDph.i, ECycles.i
Global Count.i, Index.i, Adr.i, Val.i, Space.i, Ran.i, Lcg.i, WaitStart.i, StartTime.i
Global ApiFailures.i
Global Dim Expect.a(256)
Global Dim ExtraSfr.i(9)
Global Dim ExtraExpect.i(9)
Global Dim RamPokeAdr.i(8)
Global Dim RamPokeVal.i(8)
Global RamPokes.i

Procedure.i ByteIn()
  Protected b.i
  b = PeekA(Cursor) & 255
  Cursor = Cursor + 1
  ProcedureReturn b
EndProcedure
Procedure.i WordIn()
  Protected low.i
  low = ByteIn()
  ProcedureReturn low | (ByteIn() << 8)
EndProcedure
Procedure.i LongIn()
  Protected low.i
  low = WordIn()
  ProcedureReturn low | (WordIn() << 16)
EndProcedure

; The same LCG tools/make_vectors.py fills internal RAM with.
Procedure FillFromSeed(seed.i)
  Lcg = seed
  For Index = 0 To 255
    Lcg = ((Lcg * 1103515245) + 12345) & $FFFFFFFF
    Expect(Index) = (Lcg >> 16) & 255
  Next
EndProcedure

Procedure ApiTests()
  ApiFailures = 0
  M51Reset()
  If M51Run(0) <> 0 Or M51Run(-5) <> 0 Or M51PC <> 0
    ApiFailures = ApiFailures + 1
  EndIf
  ; NOP / NOP / $A5: two instructions run, then a stop at $0002.
  M51Code(0) = 0 : M51Code(1) = 0 : M51Code(2) = $A5
  Ran = M51Run(100)
  CompilerIf #M51_TIMING = 1
    If Ran <> 2
      ApiFailures = ApiFailures + 1
    EndIf
  CompilerElse
    If Ran <> 2
      ApiFailures = ApiFailures + 1
    EndIf
  CompilerEndIf
  If M51PC <> 2 Or M51Stopped <> 1 Or M51BadOpcode <> $A5 Or M51Run(10) <> 0
    ApiFailures = ApiFailures + 1
  EndIf
  M51Reset()
  If M51Stopped <> 0 Or M51SP <> 7 Or M51Psw() <> 0 Or M51ReadDirect($90) <> $FF
    ApiFailures = ApiFailures + 1
  EndIf
  ; Bank select through PSW: MOV PSW,#$18 / MOV R0,#$5A lands at $18.
  M51Code(0) = $75 : M51Code(1) = $D0 : M51Code(2) = $18
  M51Code(3) = $78 : M51Code(4) = $5A
  CompilerIf #M51_TIMING = 1
    M51Run(3)
  CompilerElse
    M51Run(2)
  CompilerEndIf
  If M51IRam($18) <> $5A
    ApiFailures = ApiFailures + 1
  EndIf
  ; Port pins: MOV A,P1 reads latch AND pins; ANL P1,#$0F reads the latch.
  M51Reset()
  M51SetPins(1, $3C)
  M51Code(0) = $E5 : M51Code(1) = $90 : M51Code(2) = $53 : M51Code(3) = $90 : M51Code(4) = $0F
  M51Run(1)
  If M51A <> $3C
    ApiFailures = ApiFailures + 1
  EndIf
  M51Run(1)
  If M51Sfr($10) <> $0F
    ApiFailures = ApiFailures + 1
  EndIf
  M51SetPins(1, $FF)
  ; Serial: MOV SBUF,#'Z' queues the byte and sets TI.
  M51Reset()
  M51Code(0) = $75 : M51Code(1) = $99 : M51Code(2) = 90
  M51Run(1)
  If M51SerialTxGet() <> 90 Or M51SerialTxGet() <> -1 Or (M51Sfr($18) & 2) = 0
    ApiFailures = ApiFailures + 1
  EndIf
  Say("API checks failures=") : Num(ApiFailures)
  If ApiFailures = 0
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
EndProcedure

Procedure ShowFailure()
  Say("VECTOR FAIL case=") : Num(CaseIndex)
  Say(" op=$") : Hex2(M51Code(VPC))
  Say(" PC=") : Num(M51PC) : Say("/") : Num(EPC)
  Say(" A=") : Num(M51A) : Say("/") : Num(EAcc)
  Say(" B=") : Num(M51B) : Say("/") : Num(EB)
  Say(" PSW=") : Num(M51Psw()) : Say("/") : Num(EPsw)
  Say(" SP=") : Num(M51SP) : Say("/") : Num(ESP)
  Say(" DPTR=") : Num(M51DPTR) : Say("/") : Num((EDph << 8) | EDpl)
  Say(" ran=") : Num(Ran) : Say("/") : Num(ECycles)
  Say(" mem=") : Num(CaseFail)
  Eol()
EndProcedure

Procedure VectorTests()
  ExtraSfr(0) = $89 : ExtraSfr(1) = $8A : ExtraSfr(2) = $8B : ExtraSfr(3) = $8C : ExtraSfr(4) = $8D
  ExtraSfr(5) = $CA : ExtraSfr(6) = $CB : ExtraSfr(7) = $CC : ExtraSfr(8) = $CD
  Cursor = ?Vectors
  PassCount = 0 : Failures = 0 : Shown = 0
  StartTime = Micros()
  For CaseIndex = 0 To #VECTOR_COUNT - 1
    VSeed = LongIn() : VPC = WordIn() : VLen = ByteIn()
    M51Reset()
    For Index = 0 To VLen - 1
      M51Code((VPC + Index) & $FFFF) = ByteIn()
    Next
    VAcc = ByteIn() : VB = ByteIn() : VPsw = ByteIn() : VSP = ByteIn() : VDpl = ByteIn() : VDph = ByteIn()
    Count = ByteIn()
    RamPokes = 0
    For Index = 1 To Count
      Space = ByteIn() : Adr = WordIn() : Val = ByteIn()
      If Space = 0
        M51Code(Adr) = Val
      ElseIf Space = 1
        M51XData(Adr) = Val
      Else
        RamPokeAdr(RamPokes) = Adr
        RamPokeVal(RamPokes) = Val
        RamPokes = RamPokes + 1
      EndIf
    Next
    FillFromSeed(VSeed)
    For Index = 0 To RamPokes - 1
      Expect(RamPokeAdr(Index)) = RamPokeVal(Index)
    Next
    For Index = 0 To 255
      M51IRam(Index) = Expect(Index)
    Next
    M51A = VAcc : M51B = VB : M51SP = VSP : M51DPTR = (VDph << 8) | VDpl
    M51SetPsw(VPsw)
    M51PC = VPC
    EPC = WordIn() : EAcc = ByteIn() : EB = ByteIn() : EPsw = ByteIn() : ESP = ByteIn()
    EDpl = ByteIn() : EDph = ByteIn() : ECycles = ByteIn()
    Ran = M51Run(1)
    CaseFail = 0
    If M51PC <> EPC Or M51A <> EAcc Or M51B <> EB Or M51Psw() <> EPsw Or M51SP <> ESP
      CaseFail = 1
    EndIf
    If M51DPTR <> ((EDph << 8) | EDpl)
      CaseFail = 1
    EndIf
    CompilerIf #M51_TIMING = 1
      If Ran <> ECycles
        CaseFail = 1
      EndIf
    CompilerElse
      If Ran <> 1
        CaseFail = 1
      EndIf
    CompilerEndIf
    ; Internal RAM: the seeded fill with the expected changes applied.
    Count = ByteIn()
    For Index = 1 To Count
      Adr = ByteIn() : Val = ByteIn()
      Expect(Adr) = Val
    Next
    For Index = 0 To 255
      If M51IRam(Index) <> Expect(Index)
        CaseFail = CaseFail | 2
      EndIf
    Next
    ; Stopped timer registers: 0 unless the vector wrote them.
    For Index = 0 To 8
      ExtraExpect(Index) = 0
    Next
    Count = ByteIn()
    For Index = 1 To Count
      Adr = ByteIn() : Val = ByteIn()
      For Space = 0 To 8
        If ExtraSfr(Space) = Adr
          ExtraExpect(Space) = Val
        EndIf
      Next
    Next
    For Index = 0 To 8
      If M51Sfr(ExtraSfr(Index) & $7F) <> ExtraExpect(Index)
        CaseFail = CaseFail | 4
      EndIf
    Next
    Count = ByteIn()
    For Index = 1 To Count
      Adr = WordIn() : Val = ByteIn()
      If M51XData(Adr) <> Val
        CaseFail = CaseFail | 8
      EndIf
    Next
    If CaseFail
      Failures = Failures + 1
      If Shown < 40
        ShowFailure()
        Shown = Shown + 1
      EndIf
    Else
      PassCount = PassCount + 1
    EndIf
    If (CaseIndex & 127) = 0
      UsbSerialTask() : SafetyPet()
    EndIf
  Next
  Say("single-instruction vectors passed=") : Num(PassCount)
  Say(" failed=") : Num(Failures)
  Say(" us=") : Num(Micros() - StartTime)
  If Failures = 0
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
EndProcedure

; Programs built by PureMetal Forge's 8051 target. Pass 1 single-steps to the
; program's final jump-to-self, counting instructions and cycles against
; uCsim's; pass 2 runs it again in large windows, for speed.
Global PName.i, PLen.i, PTrap.i, PInst.i, PCycles.i, PCode.i, PChecks.i, PSteps.i, PFail.i, PBad.i
Global PWidth.i, PWant.i, PGot.i, PTotal.i, PUs.i, PCyc1.i

Procedure LoadTestImage()
  For Index = 0 To 65535
    M51Code(Index) = 0
    M51XData(Index) = 0
  Next
  For Index = 0 To 255
    M51IRam(Index) = 0
  Next
  For Index = 0 To PLen - 1
    M51Code(Index) = PeekA(PCode + Index) & 255
  Next
  M51Reset()
EndProcedure

Procedure ProgramTests()
  Protected p.i
  Cursor = ?Programs
  PBad = 0
  For p = 1 To #PROGRAM_COUNT
    PName = Cursor
    While ByteIn() <> 0
    Wend
    PLen = WordIn() : PTrap = WordIn() : PInst = LongIn() : PCycles = LongIn()
    PCode = Cursor
    Cursor = Cursor + PLen
    PChecks = ByteIn()
    LoadTestImage()
    PSteps = 0
    StartTime = Micros()
    While M51PC <> PTrap And PSteps < 5000000 And M51Stopped = 0
      M51Run(1)
      PSteps = PSteps + 1
      If (PSteps & 4095) = 0
        UsbSerialTask() : SafetyPet()
      EndIf
    Wend
    PCyc1 = M51Cycles
    PFail = 0
    If M51PC <> PTrap Or PSteps + 1 <> PInst
      PFail = 1
    EndIf
    CompilerIf #M51_TIMING = 1
      If PCyc1 + 2 <> PCycles
        PFail = PFail | 2
      EndIf
    CompilerEndIf
    For Index = 1 To PChecks
      Adr = WordIn() : PWidth = ByteIn() : PWant = LongIn()
      PGot = 0
      Val = PWidth
      While Val > 0
        Val = Val - 1
        PGot = (PGot << 8) | M51XData(Adr + Val)
      Wend
      If PGot <> PWant
        PFail = PFail | 4
        Say("  result at XDATA ") : Num(Adr) : Say(" = ") : Num(PGot) : Say(", expected ") : Num(PWant) : Eol()
      EndIf
    Next
    ; Pass 2: the same program in windows of 10000, timed.
    LoadTestImage()
    PTotal = 0
    StartTime = Micros()
    While M51PC <> PTrap And PTotal < 50000000 And M51Stopped = 0
      PTotal = PTotal + M51Run(10000)
    Wend
    PUs = Micros() - StartTime
    UsbSerialTask() : SafetyPet()
    Say("program ") : SayAt(PName)
    Say(" instructions=") : Num(PSteps) : Say("+1/") : Num(PInst)
    CompilerIf #M51_TIMING = 1
      Say(" cycles=") : Num(PCyc1) : Say("+2/") : Num(PCycles)
    CompilerEndIf
    Say(" results=") : Num(PChecks)
    Say(" window-run us=") : Num(PUs)
    CompilerIf #M51_TIMING = 1
      Say(" machine-cycles/s=")
    CompilerElse
      Say(" instructions/s=")
    CompilerEndIf
    If PUs > 0
      Num(Rate(PTotal, PUs))
    EndIf
    If PFail
      Say(" FAIL code=") : Num(PFail)
      PBad = PBad + 1
    Else
      Say(" PASS")
    EndIf
    Eol()
  Next
  Say("compiled 8051 programs failed=") : Num(PBad)
  If PBad = 0
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
EndProcedure

; Interrupt, timer and serial programs (tests/asm), against uCsim's end state.
Global AFlags.i, AIram.i, ASent.i, AGot.i, AInts.i
Procedure AsmTests()
  Protected p.i, k.i
  Cursor = ?AsmData
  PBad = 0
  For p = 1 To #ASM_TEST_COUNT
    PName = Cursor
    While ByteIn() <> 0
    Wend
    AFlags = ByteIn() : PLen = WordIn() : PTrap = WordIn() : PInst = LongIn() : PCycles = LongIn()
    AInts = WordIn()
    PCode = Cursor
    Cursor = Cursor + PLen
    AIram = Cursor
    Cursor = Cursor + $30
    ASent = ByteIn()
    Say("asm ") : SayAt(PName)
    CompilerIf #M51_TIMING = 0
      If AFlags & 2
        Say(" skipped: it counts machine cycles, this build counts instructions") : Eol()
        Cursor = Cursor + ASent
        Continue
      EndIf
    CompilerEndIf
    LoadTestImage()
    PSteps = 0
    While M51PC <> PTrap And PSteps < 2000000 And M51Stopped = 0
      M51Run(1)
      PSteps = PSteps + 1
      If (PSteps & 4095) = 0
        UsbSerialTask() : SafetyPet()
      EndIf
    Wend
    PFail = 0
    If M51PC <> PTrap
      PFail = 1
    EndIf
    ; Each interrupt entry is one M51Run(1) call that runs no instruction.
    PSteps = PSteps - M51IntCount
    If AFlags & 1
      If PSteps + 1 <> PInst Or M51IntCount <> AInts
        PFail = PFail | 2
      EndIf
      CompilerIf #M51_TIMING = 1
        If M51Cycles + 2 <> PCycles
          PFail = PFail | 4
        EndIf
      CompilerEndIf
    EndIf
    For k = 0 To $2F
      If M51IRam($30 + k) <> (PeekA(AIram + k) & 255)
        If (PFail & 8) = 0
          Say(" iram $") : Hex2($30 + k) : Say("=$") : Hex2(M51IRam($30 + k))
          Say(" expected $") : Hex2(PeekA(AIram + k) & 255)
        EndIf
        PFail = PFail | 8
      EndIf
    Next
    For k = 1 To ASent
      Val = ByteIn()
      AGot = M51SerialTxGet()
      If AGot < 0
        PFail = PFail | 16
      ElseIf (AGot & 255) <> Val
        PFail = PFail | 16
      EndIf
    Next
    If M51SerialTxGet() <> -1
      PFail = PFail | 16
    EndIf
    Say(" instructions=") : Num(PSteps) : Say("+1/") : Num(PInst)
    CompilerIf #M51_TIMING = 1
      Say(" cycles=") : Num(M51Cycles) : Say("+2/") : Num(PCycles)
    CompilerEndIf
    Say(" interrupts=") : Num(M51IntCount) : Say("/") : Num(AInts)
    Say(" serial-bytes=") : Num(ASent)
    If PFail
      Say(" FAIL code=") : Num(PFail)
      PBad = PBad + 1
    Else
      Say(" PASS")
    EndIf
    Eol()
  Next
  Say("interrupt/timer/serial programs failed=") : Num(PBad)
  If PBad = 0
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
EndProcedure

