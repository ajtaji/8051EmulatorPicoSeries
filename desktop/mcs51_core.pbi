Procedure M51OpF1() ; $F1 ACALL page7, 2 cycles
  M51Tmp = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  M51Push(M51PC & 255)
  M51Push(M51PC >> 8)
  M51PC = (M51PC & $F800) | 1792 | M51Tmp
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 2
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
