Procedure M51Op24() ; $24 ADD A,#imm, 1 cycle
  M51Val = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  M51Res = M51A + M51Val
  M51AcX = M51A ! M51Val ! M51Res
  M51OvX = (M51A ! M51Res) & (M51Val ! M51Res)
  M51CyX = M51Res
  M51A = M51Res & 255
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
