Procedure M51OpD2() ; $D2 SETB bit, 1 cycle
  M51Tmp = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  If M51Tmp < $80
    M51Ea = $20 + (M51Tmp >> 3)
    M51IRam(M51Ea) = M51IRam(M51Ea) | (1 << (M51Tmp & 7))
  Else
    M51BitWrite(M51Tmp, 1)
  EndIf
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51OpD3() ; $D3 SETB C, 1 cycle
  M51CyX = $100
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51OpD4() ; $D4 DA A, 1 cycle
  M51Res = M51A
  If (M51Res & 15) > 9 Or (M51AcX & 16) <> 0
    M51Res = M51Res + 6
    If M51Res > 255
      M51CyX = M51CyX | $100
    EndIf
    M51Res = M51Res & 255
  EndIf
  If (M51Res >> 4) > 9 Or (M51CyX & $100) <> 0
    M51Res = M51Res + $60
    If M51Res > 255
      M51CyX = M51CyX | $100
    EndIf
  EndIf
  M51A = M51Res & 255
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51OpD5() ; $D5 DJNZ dir,rel, 2 cycles
  M51Ea = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  If M51Ea < $80
    M51Val = M51IRam(M51Ea)
  Else
    M51Val = M51SfrReadLatch(M51Ea)
  EndIf
  M51Val = (M51Val - 1) & 255
  If M51Ea < $80
    M51IRam(M51Ea) = M51Val
  Else
    M51SfrWrite(M51Ea, M51Val)
  EndIf
  If M51Val <> 0
    M51PC = (M51PC + 1 + PeekB(@M51Code(0) + M51PC)) & $FFFF
    CompilerIf #M51_TIMING = 1
      M51Left = M51Left - 2
    CompilerElse
      M51Left = M51Left - 1
    CompilerEndIf
    ProcedureReturn
  Else
    M51PC = (M51PC + 1) & $FFFF
    CompilerIf #M51_TIMING = 1
      M51Left = M51Left - 2
    CompilerElse
      M51Left = M51Left - 1
    CompilerEndIf
    ProcedureReturn
  EndIf
EndProcedure
Procedure M51OpD6() ; $D6 XCHD A,@R0, 1 cycle
  M51Tmp = M51IRam(M51RB)
  M51RdInd(M51Val, M51Tmp)
  M51Res = (M51Val & $F0) | (M51A & 15)
  M51WrInd(M51Tmp, M51Res)
  M51A = (M51A & $F0) | (M51Val & 15)
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51OpD7() ; $D7 XCHD A,@R1, 1 cycle
  M51Tmp = M51IRam(M51RB + 1)
  M51RdInd(M51Val, M51Tmp)
  M51Res = (M51Val & $F0) | (M51A & 15)
  M51WrInd(M51Tmp, M51Res)
  M51A = (M51A & $F0) | (M51Val & 15)
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51OpD8() ; $D8 DJNZ R0,rel, 2 cycles
  M51Res = (M51IRam(M51RB) - 1) & 255
  M51IRam(M51RB) = M51Res
  If M51Res <> 0
    M51PC = (M51PC + 1 + PeekB(@M51Code(0) + M51PC)) & $FFFF
    CompilerIf #M51_TIMING = 1
      M51Left = M51Left - 2
    CompilerElse
      M51Left = M51Left - 1
    CompilerEndIf
    ProcedureReturn
  Else
    M51PC = (M51PC + 1) & $FFFF
