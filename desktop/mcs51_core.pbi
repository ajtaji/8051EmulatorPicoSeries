Procedure M51Op10() ; $10 JBC bit,rel, 2 cycles
  M51Tmp = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  If M51BitReadLatch(M51Tmp)
    M51BitWrite(M51Tmp, 0)
    M51PC = (M51PC + 1 + PeekB(@M51Code(0) + M51PC)) & $FFFF
  Else
    M51PC = (M51PC + 1) & $FFFF
  EndIf
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 2
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51Op11() ; $11 ACALL page0, 2 cycles
  M51Tmp = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  M51Push(M51PC & 255)
  M51Push(M51PC >> 8)
  M51PC = (M51PC & $F800) | 0 | M51Tmp
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 2
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51Op12() ; $12 LCALL addr16, 2 cycles
  M51Ea = (M51Code(M51PC) << 8) | M51Code((M51PC + 1) & $FFFF)
  M51PC = (M51PC + 2) & $FFFF
  M51Push(M51PC & 255)
  M51Push(M51PC >> 8)
  M51PC = M51Ea
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 2
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51Op13() ; $13 RRC A, 1 cycle
  M51Tmp = (M51A & 1) << 8
  M51A = (M51A >> 1) | ((M51CyX >> 1) & $80)
  M51CyX = M51Tmp
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
