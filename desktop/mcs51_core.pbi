    M51Ops($FE) = @M51OpFE()
    M51Ops($FF) = @M51OpFF()
    M51Ready = 1
  EndIf
  M51Budget = n
  M51Left = n
  M51Stolen = 0
  While M51Left > 0
    M51OpCall = M51Ops(M51Code(M51PC))
    M51PC = (M51PC + 1) & $FFFF
    M51OpCall()
  Wend
  M51Res = M51Budget - M51Stolen - M51Left
  M51Cycles = M51Cycles + M51Res
  M51SliceBase = M51Cycles
  M51Budget = 0
  M51Stolen = 0
  M51Left = 0
  ProcedureReturn M51Res
EndProcedure
CompilerEndIf

; ---- the program's interface -------------------------------------------------

; Power-on reset of the registers and SFRs. Internal RAM, code and XDATA are
; left as they are, as on the chip.
Procedure M51Reset()
  Protected i.i
  For i = 0 To 127
    M51Sfr(i) = 0
    M51SfrKind(i) = 0
  Next
  M51SfrKind($00) = 1 : M51SfrKind($10) = 1 : M51SfrKind($20) = 1 : M51SfrKind($30) = 1
  M51SfrKind($19) = 2
  M51SfrKind($08) = 3 : M51SfrKind($09) = 3 : M51SfrKind($0A) = 3 : M51SfrKind($0B) = 3
  M51SfrKind($0C) = 3 : M51SfrKind($0D) = 3
  M51SfrKind($28) = 4 : M51SfrKind($38) = 4
  M51SfrKind($07) = 5
  M51SfrKind($18) = 6
  CompilerIf #M51_8052 = 1
    M51SfrKind($48) = 3 : M51SfrKind($4A) = 3 : M51SfrKind($4B) = 3
    M51SfrKind($4C) = 3 : M51SfrKind($4D) = 3
  CompilerEndIf
  M51Sfr($00) = $FF : M51Sfr($10) = $FF : M51Sfr($20) = $FF : M51Sfr($30) = $FF
  If M51PinsReady = 0
    For i = 0 To 3
      M51Pins(i) = $FF
    Next
    M51Int0Pin = 1 : M51Int1Pin = 1 : M51T2ExPin = 1
    M51PinsReady = 1
  EndIf
  M51PC = 0 : M51A = 0 : M51B = 0 : M51SP = 7 : M51DPTR = 0
  M51PswSet(0)
  M51SbufRx = 0
  M51IntActive = 0 : M51IntHold = 0 : M51Idle = 0 : M51PowerDown = 0
  M51Stopped = 0 : M51BadOpcode = 0
  M51Cycles = 0 : M51SliceBase = 0 : M51TimerCycle = 0
  M51Budget = 0 : M51Stolen = 0 : M51Left = 0
  M51TxHead = 0 : M51TxTail = 0 : M51TxLost = 0
  M51IntCount = 0
EndProcedure

Procedure.i M51Psw()
  ProcedureReturn M51PswGet()
EndProcedure

Procedure M51SetPsw(v.i)
  M51PswSet(v & 255)
EndProcedure

; Direct-address access as an instruction sees it: below $80 internal RAM,
; from $80 the SFRs (with every side effect of an instruction's access).
Procedure.i M51ReadDirect(adr.i)
  If adr < $80
    ProcedureReturn M51IRam(adr)
  EndIf
  ProcedureReturn M51SfrRead(adr)
EndProcedure

Procedure M51WriteDirect(adr.i, v.i)
  If adr < $80
    M51IRam(adr) = v & 255
  Else
    M51SfrWrite(adr, v)
  EndIf
EndProcedure

; Input pin levels of port 0-3 as a byte (used when #M51_SFR_HOOK = 0).
Procedure M51SetPins(port.i, v.i)
  M51Pins(port & 3) = v & 255
EndProcedure

; INT0 / INT1 pin level (1 high, 0 low). A falling edge sets IE0 / IE1 when
; the input is edge-triggered; when it is level-triggered the flag follows
; the pin. A timer gated by the pin counts only while it is high.
Procedure M51SetInt0(level.i)
  M51TimerSync()
  If level = 0 And M51Int0Pin <> 0 And (M51Sfr($08) & 1) <> 0
    M51Sfr($08) = M51Sfr($08) | 2
  EndIf
  M51Int0Pin = level
EndProcedure

Procedure M51SetInt1(level.i)
  M51TimerSync()
  If level = 0 And M51Int1Pin <> 0 And (M51Sfr($08) & 4) <> 0
    M51Sfr($08) = M51Sfr($08) | 8
  EndIf
  M51Int1Pin = level
EndProcedure

; T2EX pin (8052). A falling edge with EXEN2 set sets EXF2 and either
; captures timer 2 into RCAP2 or reloads it from RCAP2.
Procedure M51SetT2Ex(level.i)
  Protected t2.i
  CompilerIf #M51_8052 = 1
    M51TimerSync()
    t2 = M51Sfr($48)
    If level = 0 And M51T2ExPin <> 0 And (t2 & 8) <> 0
      M51Sfr($48) = t2 | $40
      If t2 & 1
        M51Sfr($4A) = M51Sfr($4C)
        M51Sfr($4B) = M51Sfr($4D)
      ElseIf (t2 & $30) = 0
        M51Sfr($4C) = M51Sfr($4A)
        M51Sfr($4D) = M51Sfr($4B)
      EndIf
    EndIf
  CompilerEndIf
  M51T2ExPin = level
EndProcedure

; External count pulses (falling edges on T0 / T1 / T2) for a timer in
; counter mode. Returns 1 if the pulses made it overflow.
Procedure.i M51CountPulses(timer.i, n.i)
  Protected tmod.i, tcon.i
  M51TimerSync()
  tmod = M51Sfr($09)
  tcon = M51Sfr($08)
  If timer = 0
    If (tmod & 4) <> 0 And (tcon & $10) <> 0
      If (tmod & 8) = 0 Or M51Int0Pin <> 0
        ProcedureReturn M51Timer0Count(n)
      EndIf
    EndIf
  ElseIf timer = 1
    If (tmod & $40) <> 0 And (tcon & $40) <> 0
      If (tmod & $80) = 0 Or M51Int1Pin <> 0
        ProcedureReturn M51Timer1Count(n)
      EndIf
    EndIf
  CompilerIf #M51_8052 = 1
  ElseIf timer = 2
    If (M51Sfr($48) & 6) = 6
      ProcedureReturn M51Timer2Count(n)
    EndIf
  CompilerEndIf
  EndIf
  ProcedureReturn 0
EndProcedure

; Offers one received frame (bit 8 = the ninth bit in modes 2 and 3).
; Returns 1 if it was taken (or dropped by the SM2 address filter), 0 if the
; receiver is off or RI is still set: offer it again later.
Procedure.i M51SerialReceive(w.i)
  Protected scon.i, rb8.i
  scon = M51Sfr($18)
  If (scon & $10) = 0 Or (scon & 1) <> 0
    ProcedureReturn 0
  EndIf
  If scon & $80
    rb8 = (w >> 8) & 1
    If (scon & $20) <> 0 And rb8 = 0
      ProcedureReturn 1
    EndIf
  Else
    rb8 = 1
  EndIf
  M51SbufRx = w & 255
  M51Sfr($18) = (scon & $FB) | (rb8 << 2) | 1
  ProcedureReturn 1
EndProcedure

; Bytes written to SBUF (when #M51_SERIAL_HOOK = 0): -1 when none is queued.
Procedure.i M51SerialTxGet()
  Protected w.i
  If M51TxHead = M51TxTail
    ProcedureReturn -1
  EndIf
  w = M51TxBuf(M51TxTail)
  M51TxTail = (M51TxTail + 1) & 63
  ProcedureReturn w
EndProcedure

; Runs the CPU for n machine cycles (#M51_TIMING = 1) or n instructions
; (#M51_TIMING = 0) and returns how many it ran: whole instructions only, so
; a timed run can finish up to three cycles past n. Interrupts are polled
; between instructions whenever a request can have changed. Returns 0 when
; stopped on an undefined opcode ($A5) or in power-down.
Procedure.i M51Run(n.i)
  Protected done.i, slice.i, ran.i, ev.i
  If n <= 0 Or M51Stopped <> 0 Or M51PowerDown <> 0
    ProcedureReturn 0
  EndIf
  done = 0
  While done < n
    If M51IntHold
      M51IntHold = 0
      slice = 1
    Else
      If M51IntPoll()
        ; The hardware LCALL to the vector.
        CompilerIf #M51_TIMING = 1
          ran = 2
        CompilerElse
          ran = 1
        CompilerEndIf
        M51Cycles = M51Cycles + ran
        M51SliceBase = M51Cycles
        M51TimerSync()
        done = done + ran
        Continue
      EndIf
      slice = n - done
      ev = M51NextEvent()
      If ev < slice
        slice = ev
      EndIf
      If M51Idle
        M51Cycles = M51Cycles + slice
        M51SliceBase = M51Cycles
        M51TimerSync()
        done = done + slice
        Continue
      EndIf
    EndIf
    ran = M51Slice(slice)
    M51TimerSync()
    done = done + ran
    If M51Stopped <> 0 Or M51PowerDown <> 0
      Break
    EndIf
  Wend
  ProcedureReturn done
EndProcedure

