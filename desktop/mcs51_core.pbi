Procedure M51Op30() ; $30 JNB bit,rel, 2 cycles
  M51Tmp = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  If M51BitRead(M51Tmp) = 0
    M51PC = (M51PC + 1 + PeekB(@M51Code(0) + M51PC)) & $FFFF
    CompilerIf #M51_TIMING = 1
      M51Left = M51Left - 2
    CompilerElse
      M51Left = M51Left - 1
    CompilerEndIf
    ProcedureReturn
  Else
    M51PC = (M51PC + 1) & $FFFF
    CompilerIf #M51_TIMING = 1
      M51Left = M51Left - 2
    CompilerElse
      M51Left = M51Left - 1
    CompilerEndIf
    ProcedureReturn
  EndIf
EndProcedure
Procedure M51Op31() ; $31 ACALL page1, 2 cycles
  M51Tmp = M51Code(M51PC)
  M51PC = (M51PC + 1) & $FFFF
  M51Push(M51PC & 255)
  M51Push(M51PC >> 8)
  M51PC = (M51PC & $F800) | 256 | M51Tmp
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 2
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51Op32() ; $32 RETI, 2 cycles
  M51Pop(M51Tmp)
  M51Pop(M51Val)
  M51PC = (M51Tmp << 8) | M51Val
  If M51IntActive & 2
    M51IntActive = M51IntActive & 1
  Else
    M51IntActive = 0
  EndIf
  ; One more instruction always runs before the next interrupt.
  M51IntHold = 1
  M51ForceExit()
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 2
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure M51Op33() ; $33 RLC A, 1 cycle
  M51Res = (M51A << 1) | ((M51CyX >> 8) & 1)
  M51CyX = M51Res
  M51A = M51Res & 255
  CompilerIf #M51_TIMING = 1
    M51Left = M51Left - 1
  CompilerElse
    M51Left = M51Left - 1
  CompilerEndIf
  ProcedureReturn
