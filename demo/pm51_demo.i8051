Procedure.w Rainbow(n.w)
  ProcedureReturn PeekA(#T_RAINBOW + (n & 31))
EndProcedure

Procedure.w NoteHz(m.w)
  ProcedureReturn PeekA(#T_FREQ + (m * 2)) | (PeekA(#T_FREQ + (m * 2) + 1) << 8)
EndProcedure

Procedure WaitFrame()
  While PeekA($F001) = 0
  Wend
EndProcedure

; Voice n (0-2): frequency in Hz, volume 0-15, wave 0 square 1 triangle 2 saw 3 noise.
Procedure Voice(n.w, freq.w, vol.w, wave.w)
  a = $F010 + (n * 4)
  PokeA(a, freq & 255)
  PokeA(a + 1, (freq >> 8) & 255)
  PokeA(a + 2, vol)
  PokeA(a + 3, wave)
EndProcedure

; Text at row r, column col, from msg[) starting at index from, n characters,
; in textColour (the 8051 target passes at most four arguments).
Procedure TextFromMsg(r.w, col.w, from.w, n.w)
  a = $D000 + (r * 20) + col
  k = 0
  While k < n
    PokeA(a + k, PeekA(#T_MSG + from + k))
    PokeA(a + k + $200, textColour)
    k = k + 1
  Wend
EndProcedure

Procedure Title(colour.w)
  ; "PUREMETAL 8051" is message characters 5-18.
  textColour = colour
  TextFromMsg(1, 3, 5, 14)
EndProcedure

; The bitmap: a tunnel of 16 nested rectangles from the board's rectangle
; unit, rings of colour and rings of 0 - through which the raster bars show.
Procedure Rect(x.w, y.w, w.w, h.w)
  PokeA($F009, x)
  PokeA($F00A, y)
  PokeA($F00B, w)
  PokeA($F00C, h)
  PokeA($F00E, 1)
EndProcedure

Procedure DrawBitmap()
  k = 0
  While k < 16
    If k & 1
      PokeA($F00D, 0)
    Else
      PokeA($F00D, Rainbow(k * 2) & $6D)
    EndIf
    Rect(k * 5, k * 4, 160 - (k * 10), 128 - (k * 8))
    k = k + 1
  Wend
  ; The raster bars: a rainbow down the 128 line colours, moved by LINEOFS.
  i = 0
  While i < 128
    PokeA($DC00 + i, Rainbow(i >> 2))
    i = i + 1
  Wend
EndProcedure

; Sprite patterns 0-3: balls in four colours, lit from the top left.
Procedure DrawBalls()
  Protected p.w, r.w, cc.w, dx.w, dy.w, d.w
  p = 0
  While p < 4
    r = 0
    While r < 8
      cc = 0
      While cc < 8
        dx = (cc * 2) - 7
        dy = (r * 2) - 7
        d = (dx * dx) + (dy * dy)
        a = $D800 + (p * 64) + (r * 8) + cc
        If d > 56
          PokeA(a, 0)
        ElseIf d < 12 And dx < 0 And dy < 0
          PokeA(a, $FF)
        Else
          PokeA(a, Rainbow((p * 8) + 2))
        EndIf
        cc = cc + 1
      Wend
      r = r + 1
    Wend
    p = p + 1
  Wend
  k = 0
  While k < 8
    bx[k] = 10 + (k * 17)
    by[k] = 20 + (k * 11)
    bdx[k] = 1 + (k & 1)
    bdy[k] = 1 + ((k >> 1) & 1)
    a = $D400 + (k * 8)
    PokeA(a + 2, k & 3)
    PokeA(a + 3, 1)
    k = k + 1
  Wend
EndProcedure

Procedure MoveBalls()
  k = 0
  While k < 8
    If k = 0 And (buttons & 15) <> 0
      If buttons & 1
        by[0] = by[0] - 2
      EndIf
      If buttons & 2
        by[0] = by[0] + 2
      EndIf
      If buttons & 4
        bx[0] = bx[0] - 2
      EndIf
      If buttons & 8
        bx[0] = bx[0] + 2
      EndIf
    Else
      bx[k] = bx[k] + bdx[k]
      by[k] = by[k] + bdy[k]
    EndIf
    If bx[k] < 0
      bx[k] = 0 : bdx[k] = 0 - bdx[k]
    EndIf
    If bx[k] > 152
      bx[k] = 152 : bdx[k] = 0 - bdx[k]
    EndIf
    If by[k] < 0
      by[k] = 0 : bdy[k] = 0 - bdy[k]
    EndIf
    If by[k] > 120
      by[k] = 120 : bdy[k] = 0 - bdy[k]
    EndIf
    a = $D400 + (k * 8)
    PokeA(a, bx[k])
    PokeA(a + 1, by[k])
    k = k + 1
  Wend
EndProcedure

; One step of the tune every 6 frames (125 beats a minute in sixteenths).
Procedure Music()
  If muted
    Voice(0, 0, 0, 0)
    Voice(1, 0, 0, 1)
    Voice(2, 0, 0, 3)
    ProcedureReturn
  EndIf
  tick = tick + 1
  If tick >= 6
    tick = 0
    v = PeekA(#T_LEAD + steps)
    If v = 1
      leadVol = 0
    ElseIf v <> 0
      Voice(0, NoteHz(v), 11, 0)
      leadVol = 11
    EndIf
    v = PeekA(#T_BASS + steps)
    If v > 1
      Voice(1, NoteHz(v), 12, 1)
      bassVol = 12
    EndIf
    drumKind = PeekA(#T_DRUM + steps)
    If drumKind = 1
      Voice(2, 180, 14, 3)
      drumVol = 14
    ElseIf drumKind = 2
      Voice(2, 2600, 12, 3)
      drumVol = 12
    ElseIf drumKind = 3
      Voice(2, 7000, 5, 3)
      drumVol = 5
    EndIf
    steps = (steps + 1) & 63
  Else
    ; The envelopes: everything decays between steps.
    If leadVol > 5
      leadVol = leadVol - 1
    EndIf
    If bassVol > 7
      bassVol = bassVol - 1
    EndIf
    If drumVol > 3
      drumVol = drumVol - 4
    Else
      drumVol = 0
    EndIf
    PokeA($F012, leadVol)
    PokeA($F016, bassVol)
    PokeA($F01A, drumVol)
  EndIf
EndProcedure

; ---- the program ------------------------------------------------------------
PokeA($F005, 7)
PokeA($F006, 0)
PokeA($F007, 0)
PokeA($F004, 0)
InitTables()
DrawBitmap()
DrawBalls()
PokeA($F01C, 12)
direction = 1
frame = 0
Repeat
  WaitFrame()
  frame = frame + 1
  buttons = PeekA($F008)
  If (buttons & 16) <> 0 And (lastButtons & 16) = 0
    direction = 0 - direction
  EndIf
  If (buttons & 32) <> 0 And (lastButtons & 32) = 0
    muted = 1 - muted
  EndIf
  lastButtons = buttons
  ; Raster bars: one write moves them all.
  PokeA($F00F, (frame * 2) & 127)
  ; The bitmap drifts; the title cycles its colour.
  PokeA($F002, (frame * direction) & 255)
  PokeA($F003, (frame >> 1) & 127)
  If (frame & 3) = 0
    Title(Rainbow((frame >> 2) & 31))
  EndIf
  ; The scroller on row 14: one character every 8 frames.
  If (frame & 7) = 0
    textColour = $FF
    TextFromMsg(14, 0, scrollPos, 20)
    scrollPos = scrollPos + 1
    If scrollPos > 208 - 20
      scrollPos = 0
    EndIf
  EndIf
  MoveBalls()
  Music()
ForEver
