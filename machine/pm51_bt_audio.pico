; The PM51 board's sound on a Bluetooth speaker (A2DP), the NES's way: core 0
; runs the board and mixes each frame's 800 samples (48 kHz, 60 frames a second) into a ring; core
; 1 draws the panel and drives the radio between lines, and the library reads
; the ring itself (BtAudioSource).
;
; Silent unless a PRIVATE wrapper (my-*.picow, never in git) names the speaker
; before Main(), exactly as the NES does it:
;     DataSection
;     MySpeaker:
;       Data.a <6 bytes, least significant first (HCI order)>
;     EndDataSection
;     PM51SetSpeaker(?MySpeaker)
; The link key lives where the NES and PureMetal Forge's examples keep it: the
; record "BTK1" + 22 bytes in the flash chip's last sector ($1FF000), so a
; speaker paired once reconnects without pairing again.

#PM51_RING = 8192                   ; 170 ms: room for a catch-up burst of 8 frames
#PM51_KEY_SECTOR = $1FF000

Global Dim PM51Pcm.w(#PM51_RING)
Global PM51PcmCount.l, PM51AudioOn.i, PM51SpeakerSet.i, PM51AudioRc.i
Global Dim PM51Speaker.a(6)
Global Dim PM51KeyPage.a(256)

; The speaker's address in HCI order (as the NES's private wrapper keeps it).
Procedure PM51SetSpeaker(src.i)
  Protected i.i
  For i = 0 To 5
    PM51Speaker(i) = PeekA(src + 5 - i)
  Next
  PM51SpeakerSet = 1
EndProcedure

Procedure.i PM51SaveKey()
  Protected i.i
  For i = 0 To 255
    PM51KeyPage(i) = 255
  Next
  PM51KeyPage(0) = 66 : PM51KeyPage(1) = 84 : PM51KeyPage(2) = 75 : PM51KeyPage(3) = 49
  If BtAudioKey(@PM51KeyPage(4)) = 0
    ProcedureReturn 0
  EndIf
  If FlashRangeErase(#PM51_KEY_SECTOR, 4096) = 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn FlashRangeProgram(#PM51_KEY_SECTOR, @PM51KeyPage(0), 256)
EndProcedure

; Core 1 draws the panel (Core1Main, pm51_picow_body) and calls this between
; lines and between frames: the radio, the encoder and the sender.
Procedure PM51AudioPoll()
  If PM51AudioOn
    BtAudioPoll()
  EndIf
EndProcedure

; 1 when core 1 may park for an upload's reboot: no speaker, or BtAudioPoll()
; has disconnected it, which it does once the reboot is pending. (2026-10-24:
; a Pico W whose core 1 kept the radio going through the reboot left USB
; entirely and needed a replug.)
Procedure.i PM51AudioQuiet()
  If PM51AudioOn = 0 Or btaud_ending <> 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; The RP2040's half of the panel code: DMA's TREQ field and core 1's start.
#PM51_TREQ_SHIFT = 15
#PM51_PANEL_BITS = 16               ; 100 MHz SPI sends 16-bit pixels at 60 frames a second
Procedure.i PM51StartCore1()
  ProcedureReturn multicore_launch()
EndProcedure

; Connects (up to 45 s); core 1 then drives the radio (PM51AudioPoll). Silent and harmless
; without a speaker.
Procedure PM51AudioBegin()
  Protected k.i
  If PM51SpeakerSet = 0
    Say("PM51 sound: no speaker named (a private wrapper names it); silent") : Eol()
    ProcedureReturn
  EndIf
  k = $10000000 + #PM51_KEY_SECTOR
  If PeekA(k) = 66 And PeekA(k + 1) = 84 And PeekA(k + 2) = 75 And PeekA(k + 3) = 49
    BtAudioSetKey(k + 4)
  EndIf
  BtAudioStereo(1)
  Say("PM51 sound: connecting to the speaker") : Eol()
  PM51AudioRc = BtAudioBegin(@PM51Speaker(0))
  Say("PM51 sound: BtAudioBegin=") : Num(PM51AudioRc) : Eol()
  If PM51AudioRc <> 0
    ProcedureReturn
  EndIf
  If BtAudioKeyNew()
    ; Core 1 is not running yet, so flash may be written now.
    If PM51SaveKey()
      Say("PM51 sound: paired; link key saved") : Eol()
    EndIf
  EndIf
  PM51PcmCount = 0
  BtAudioSource(@PM51Pcm(0), #PM51_RING, @PM51PcmCount)
  BtAudioLead(60000)
  BtAudioPumps(0)
  PM51AudioOn = 1
EndProcedure

; After each board frame: its #PM51_SAMPLES_48K (800) samples into the ring, then the count.
Procedure PM51AudioFrame()
  Protected pos.i, n1.i
  If PM51AudioOn = 0
    ProcedureReturn
  EndIf
  pos = PM51PcmCount & (#PM51_RING - 1)
  n1 = #PM51_RING - pos
  If n1 > #PM51_SAMPLES_48K
    n1 = #PM51_SAMPLES_48K
  EndIf
  PM51Mix(@PM51Pcm(pos), n1, 48000)
  If n1 < #PM51_SAMPLES_48K
    PM51Mix(@PM51Pcm(0), #PM51_SAMPLES_48K - n1, 48000)
  EndIf
  PM51PcmCount = PM51PcmCount + #PM51_SAMPLES_48K
EndProcedure
