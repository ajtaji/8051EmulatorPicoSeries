; The PM51 display board on a Pico W (LAFVIN ST7796 panel), running the 8051
; program embedded by tools/embed_program.py (the demo by default).
#CLOCK_KHZ = 200000
#M51_TIMING = 1
#M51_ASM_TAIL = 1
#M51_8052 = 1
#M51_SFR_HOOK = 0
#M51_XDATA_HOOK = 2
#M51_XIO_PAGE = $F000
#M51_CODE_HOOK = 0
#M51_SERIAL_HOOK = 0
EnableExplicit
XIncludeFile "RP2040/Lib/clocks.pico"
XIncludeFile "RP2040/Lib/timer.pico"
XIncludeFile "RP2040/Lib/uart.pico"
XIncludeFile "RP2040/Lib/usb_serial.pico"
XIncludeFile "RP2040/Lib/safety.pico"
XIncludeFile "RP2040/Lib/bits.pico"
XIncludeFile "RP2040/Lib/wiring.pico"
XIncludeFile "RP2040/Lib/spi.pico"
XIncludeFile "RP2040/Lib/st7796.pico"
XIncludeFile "../src/mcs51.pico"
XIncludeFile "../src/io.pico"
XIncludeFile "pm51_font.pico"
XIncludeFile "pm51_board.pico"
XIncludeFile "pm51_program.pico"
XIncludeFile "pm51_picow_body.pico"
