; Generated by tools/generate.py. Edit the generator, then regenerate.
; Intel MCS-51 (8051 / 8052) instruction-set core for PureMetal.
; Computed-goto dispatch through a 256-entry .Label table; the handlers and
; the SFR / timer / interrupt paths they call all run from SRAM.
;
; Configure BEFORE including this file (every constant must be defined):
;   #M51_TIMING      1: M51Run(n) counts machine cycles (12 clocks each)
;                    0: M51Run(n) counts instructions (fastest)
;   #M51_ASM_TAIL    1: inline-assembly dispatch tail, 0: plain computed Goto
;   #M51_8052        1: 256 bytes of internal RAM and timer 2 (8052)
;                    0: 128 bytes, no timer 2 (8051)
;   #M51_SFR_HOOK    1: the program supplies M51HookSfrRead(adr) and
;                       M51HookSfrWrite(adr, v) for SFRs the core does not
;                       model, port pin reads and port latch writes
;   #M51_XDATA_HOOK  1: MOVX goes through M51HookXRead(adr) / M51HookXWrite(adr, v)
;                    0: 64 KB array M51XData
;                    2: the array, except the 256-byte page #M51_XIO_PAGE (also
;                       to be defined, e.g. $F000): a read there comes from
;                       M51HookXRead(adr), a write is stored and then passed to
;                       M51HookXWrite(adr, v) - memory-mapped I/O at the cost of
;                       one compare per MOVX
;   #M51_CODE_HOOK   1: MOVC reads go through M51HookCodeRead(adr)
;                       (instruction fetch always reads M51Code)
;   #M51_SERIAL_HOOK 1: each byte written to SBUF goes to M51HookSerialTx(w)
;                    0: it is queued; read it with M51SerialTxGet()
; The reserved registers are application-wide.
EnableExplicit
Global Dim M51Code.a(65536)
CompilerIf #M51_XDATA_HOOK <> 1
  Global Dim M51XData.a(65536)
CompilerEndIf
Global Dim M51IRam.a(256)
Global Dim M51Sfr.a(128)
Global Dim M51SfrKind.a(128)
Global Dim M51Pins.a(4)
Global Dim M51TxBuf.i(64)
Global Dim M51Dispatch.Label(256)
Global M51PC.i, M51A.i, M51RB.i, M51Res.i, M51Left.i
Global M51B.i, M51SP.i, M51DPTR.i
Global M51CyX.i, M51AcX.i, M51OvX.i, M51PswRest.i
Global M51Ea.i, M51Val.i, M51Tmp.i
Global M51Budget.i, M51Stolen.i, M51Ready.i, M51Stopped.i, M51BadOpcode.i
Global M51Cycles.i, M51SliceBase.i, M51TimerCycle.i
Global M51IntActive.i, M51IntHold.i, M51Idle.i, M51PowerDown.i
Global M51SbufRx.i, M51Int0Pin.i, M51Int1Pin.i, M51T2ExPin.i
Global M51TxHead.i, M51TxTail.i, M51TxLost.i, M51InitIndex.i, M51PinsReady.i, M51IntCount.i
Global M51Table.i, M51CodeBase.i, M51XioPage.i
ReserveRegister M51PC = r4, M51Table = r6, M51RB = r8, M51A = r9, M51CodeBase = r10, M51Left = r11

; ---- flags -----------------------------------------------------------------
; CY is bit 8 of M51CyX, AC bit 4 of M51AcX, OV bit 7 of M51OvX: each is the
; raw value of the last operation that set it. P is computed from A when PSW
; is read. M51PswRest holds F0, RS1, RS0 and PSW.1; M51RB is the bank base.

; Ends the current slice after this instruction: the timers, the next event
; and the interrupt request are looked at again before the next one runs.
Macro M51ForceExit()
  M51Stolen = M51Stolen + M51Left
  M51Left = 0
EndMacro

; Indirect internal RAM (@Ri, the stack). An 8051 has no upper 128 bytes:
; reads there give $FF and writes are dropped.
CompilerIf #M51_8052 = 1
  Macro M51RdInd(dst, adr)
    dst = M51IRam(adr)
  EndMacro
  Macro M51WrInd(adr, val)
    M51IRam(adr) = val
  EndMacro
CompilerElse
  Macro M51RdInd(dst, adr)
    If adr < $80
      dst = M51IRam(adr)
    Else
      dst = $FF
    EndIf
  EndMacro
  Macro M51WrInd(adr, val)
    If adr < $80
      M51IRam(adr) = val
    EndIf
  EndMacro
CompilerEndIf

Macro M51Push(val)
  M51SP = (M51SP + 1) & 255
  M51WrInd(M51SP, val)
EndMacro
Macro M51Pop(dst)
  M51RdInd(dst, M51SP)
  M51SP = (M51SP - 1) & 255
EndMacro

CompilerIf #M51_XDATA_HOOK = 1
  Macro M51XRd(dst, adr)
    dst = M51HookXRead(adr)
  EndMacro
  Macro M51XWr(adr, val)
    M51HookXWrite(adr, val)
  EndMacro
CompilerElseIf #M51_XDATA_HOOK = 2
  Macro M51XRd(dst, adr)
    If (adr & $FF00) = #M51_XIO_PAGE
      dst = M51HookXRead(adr)
    Else
      dst = M51XData(adr)
    EndIf
  EndMacro
  Macro M51XWr(adr, val)
    M51XData(adr) = val
    If (adr & $FF00) = #M51_XIO_PAGE
      M51HookXWrite(adr, val)
    EndIf
  EndMacro
CompilerElse
  Macro M51XRd(dst, adr)
    dst = M51XData(adr)
  EndMacro
  Macro M51XWr(adr, val)
    M51XData(adr) = val
  EndMacro
CompilerEndIf

CompilerIf #M51_CODE_HOOK = 1
  Macro M51CRd(dst, adr)
    dst = M51HookCodeRead(adr)
  EndMacro
CompilerElse
  Macro M51CRd(dst, adr)
    dst = M51Code(adr)
  EndMacro
CompilerEndIf

ProcedureRAM.i M51Parity(v.i)
  Protected p.i
  p = v ! (v >> 4)
  p = p ! (p >> 2)
  p = p ! (p >> 1)
  ProcedureReturn p & 1
EndProcedure

ProcedureRAM.i M51PswGet()
  ProcedureReturn M51PswRest | ((M51CyX >> 1) & $80) | ((M51AcX << 2) & $40) | ((M51OvX >> 5) & 4) | M51Parity(M51A)
EndProcedure

ProcedureRAM M51PswSet(v.i)
  M51CyX = (v & $80) << 1
  M51AcX = (v & $40) >> 2
  M51OvX = (v & 4) << 5
  M51PswRest = v & $3A
  M51RB = v & $18
EndProcedure

; ---- timers ----------------------------------------------------------------
; Timers are brought up to date lazily: at the end of every slice, and before
; any timer or control SFR is read or written. "Now" inside a slice is the
; cycle at which the current instruction started.

ProcedureRAM.i M51Timer0Count(d.i)
  Protected m.i, tl.i, th.i, total.i, per.i, hit.i
  m = M51Sfr($09) & 3
  tl = M51Sfr($0A)
  th = M51Sfr($0C)
  hit = 0
  If m = 0
    total = ((th << 5) | (tl & 31)) + d
    If total >= $2000
      hit = 1
      total = total & $1FFF
    EndIf
    M51Sfr($0A) = (tl & $E0) | (total & 31)
    M51Sfr($0C) = (total >> 5) & 255
  ElseIf m = 1
    total = ((th << 8) | tl) + d
    If total >= $10000
      hit = 1
      total = total & $FFFF
    EndIf
    M51Sfr($0A) = total & 255
    M51Sfr($0C) = total >> 8
  ElseIf m = 2
    total = tl + d
    If total >= 256
      hit = 1
      per = 256 - th
      total = th + ((total - 256) % per)
    EndIf
    M51Sfr($0A) = total
  Else
    total = tl + d
    If total >= 256
      hit = 1
      total = total & 255
    EndIf
    M51Sfr($0A) = total
  EndIf
  If hit
    M51Sfr($08) = M51Sfr($08) | $20
  EndIf
  ProcedureReturn hit
EndProcedure

; TH0 as the second 8-bit timer of mode 3: run by TR1, overflows into TF1.
ProcedureRAM.i M51Th0Count(d.i)
  Protected total.i, hit.i
  hit = 0
  total = M51Sfr($0C) + d
  If total >= 256
    hit = 1
    total = total & 255
    M51Sfr($08) = M51Sfr($08) | $80
  EndIf
  M51Sfr($0C) = total
  ProcedureReturn hit
EndProcedure

ProcedureRAM.i M51Timer1Count(d.i)
  Protected m.i, tl.i, th.i, total.i, per.i, hit.i
  m = (M51Sfr($09) >> 4) & 3
  tl = M51Sfr($0B)
  th = M51Sfr($0D)
  hit = 0
  If m = 0
    total = ((th << 5) | (tl & 31)) + d
    If total >= $2000
      hit = 1
      total = total & $1FFF
    EndIf
    M51Sfr($0B) = (tl & $E0) | (total & 31)
    M51Sfr($0D) = (total >> 5) & 255
  ElseIf m = 1
    total = ((th << 8) | tl) + d
    If total >= $10000
      hit = 1
      total = total & $FFFF
    EndIf
    M51Sfr($0B) = total & 255
    M51Sfr($0D) = total >> 8
  ElseIf m = 2
    total = tl + d
    If total >= 256
      hit = 1
      per = 256 - th
      total = th + ((total - 256) % per)
    EndIf
    M51Sfr($0B) = total
  Else
    ProcedureReturn 0
  EndIf
  ; With timer 0 in mode 3, TF1 belongs to TH0: timer 1 still counts
  ; (a baud-rate generator) but cannot set it.
  If hit
    If (M51Sfr($09) & 3) <> 3
      M51Sfr($08) = M51Sfr($08) | $80
    Else
      hit = 0
    EndIf
  EndIf
  ProcedureReturn hit
EndProcedure

CompilerIf #M51_8052 = 1
ProcedureRAM.i M51Timer2Count(d.i)
  Protected t2.i, total.i, rcap.i, per.i, hit.i, baud.i, inc.i
  t2 = M51Sfr($48)
  hit = 0
  baud = t2 & $30
  inc = d
  ; As a baud-rate generator timer 2 counts at half the oscillator.
  If baud <> 0 And (t2 & 2) = 0
    inc = d * 6
  EndIf
  total = ((M51Sfr($4D) << 8) | M51Sfr($4C)) + inc
  If total >= $10000
    If baud <> 0 Or (t2 & 1) = 0
      rcap = (M51Sfr($4B) << 8) | M51Sfr($4A)
      per = $10000 - rcap
      total = rcap + ((total - $10000) % per)
    Else
      total = total & $FFFF
    EndIf
    If baud = 0
      hit = 1
      M51Sfr($48) = t2 | $80
    EndIf
  EndIf
  M51Sfr($4C) = total & 255
  M51Sfr($4D) = total >> 8
  ProcedureReturn hit
EndProcedure
CompilerEndIf

ProcedureRAM.i M51TimerAdvance(d.i)
  Protected tmod.i, tcon.i, hit.i
  tmod = M51Sfr($09)
  tcon = M51Sfr($08)
  hit = 0
  If (tmod & 4) = 0 And (tcon & $10) <> 0
    If (tmod & 8) = 0 Or M51Int0Pin <> 0
      hit = hit | M51Timer0Count(d)
    EndIf
  EndIf
  If (tmod & 3) = 3 And (tcon & $40) <> 0
    hit = hit | M51Th0Count(d)
  EndIf
  If (tmod & $40) = 0 And (tcon & $40) <> 0
    If (tmod & $80) = 0 Or M51Int1Pin <> 0
      hit = hit | M51Timer1Count(d)
    EndIf
  EndIf
  CompilerIf #M51_8052 = 1
    If (M51Sfr($48) & 6) = 4
      hit = hit | M51Timer2Count(d)
    EndIf
  CompilerEndIf
  ProcedureReturn hit
EndProcedure

ProcedureRAM M51TimerSync()
  Protected now.i, d.i
  now = M51SliceBase + M51Budget - M51Stolen - M51Left
  d = now - M51TimerCycle
  If d > 0
    M51TimerCycle = now
    If M51TimerAdvance(d)
      M51ForceExit()
    EndIf
  EndIf
EndProcedure

ProcedureRAM.i M51ToOverflow(m.i, tl.i, th.i)
  If m = 0
    ProcedureReturn $2000 - ((th << 5) | (tl & 31))
  ElseIf m = 1
    ProcedureReturn $10000 - ((th << 8) | tl)
  EndIf
  ProcedureReturn 256 - tl
EndProcedure

; Cycles until the next timer overflow that sets a flag.
ProcedureRAM.i M51NextEvent()
  Protected best.i, tmod.i, tcon.i, c.i
  best = $3FFFFFFF
  tmod = M51Sfr($09)
  tcon = M51Sfr($08)
  If (tmod & 4) = 0 And (tcon & $10) <> 0
    If (tmod & 8) = 0 Or M51Int0Pin <> 0
      c = M51ToOverflow(tmod & 3, M51Sfr($0A), M51Sfr($0C))
      If c < best
        best = c
      EndIf
    EndIf
  EndIf
  If (tmod & 3) = 3 And (tcon & $40) <> 0
    c = 256 - M51Sfr($0C)
    If c < best
      best = c
    EndIf
  EndIf
  If (tmod & $40) = 0 And (tcon & $40) <> 0 And (tmod & 3) <> 3 And (tmod & $30) <> $30
    If (tmod & $80) = 0 Or M51Int1Pin <> 0
      c = M51ToOverflow((tmod >> 4) & 3, M51Sfr($0B), M51Sfr($0D))
      If c < best
        best = c
      EndIf
    EndIf
  EndIf
  CompilerIf #M51_8052 = 1
    If (M51Sfr($48) & $36) = 4
      c = $10000 - ((M51Sfr($4D) << 8) | M51Sfr($4C))
      If c < best
        best = c
      EndIf
    EndIf
  CompilerEndIf
  If best < 1
    best = 1
  EndIf
  ProcedureReturn best
EndProcedure

; ---- serial port -------------------------------------------------------------
; A byte written to SBUF is delivered at once and TI is set at once; the
; frame time is not modelled.
ProcedureRAM M51Transmit(v.i)
  Protected scon.i, w.i, nxt.i
  scon = M51Sfr($18)
  w = v
  If scon & $80
    w = v | ((scon & 8) << 5)
  EndIf
  CompilerIf #M51_SERIAL_HOOK = 1
    M51HookSerialTx(w)
  CompilerElse
    nxt = (M51TxHead + 1) & 63
    If nxt = M51TxTail
      M51TxLost = M51TxLost + 1
    Else
      M51TxBuf(M51TxHead) = w
      M51TxHead = nxt
    EndIf
  CompilerEndIf
  M51Sfr($18) = M51Sfr($18) | 2
  M51ForceExit()
EndProcedure

; ---- SFR space ---------------------------------------------------------------
; Kinds: 0 not modelled (hook or plain storage), 1 port latch, 2 SBUF,
; 3 timer / TCON / TMOD / timer 2, 4 IE / IP, 5 PCON, 6 SCON.
ProcedureRAM.i M51SfrRead(adr.i)
  Protected k.i
  If adr = $E0
    ProcedureReturn M51A
  ElseIf adr = $D0
    ProcedureReturn M51PswGet()
  ElseIf adr = $F0
    ProcedureReturn M51B
  ElseIf adr = $81
    ProcedureReturn M51SP
  ElseIf adr = $82
    ProcedureReturn M51DPTR & 255
  ElseIf adr = $83
    ProcedureReturn M51DPTR >> 8
  EndIf
  k = M51SfrKind(adr & $7F)
  If k = 1
    CompilerIf #M51_SFR_HOOK = 1
      ProcedureReturn M51Sfr(adr & $7F) & M51HookSfrRead(adr)
    CompilerElse
      ProcedureReturn M51Sfr(adr & $7F) & M51Pins((adr >> 4) & 3)
    CompilerEndIf
  ElseIf k = 2
    ProcedureReturn M51SbufRx
  ElseIf k = 3
    M51TimerSync()
    ProcedureReturn M51Sfr(adr & $7F)
  ElseIf k = 0
    CompilerIf #M51_SFR_HOOK = 1
      ProcedureReturn M51HookSfrRead(adr)
    CompilerEndIf
  EndIf
  ProcedureReturn M51Sfr(adr & $7F)
EndProcedure

; Read-modify-write instructions read a port's latch, not its pins.
ProcedureRAM.i M51SfrReadLatch(adr.i)
  If M51SfrKind(adr & $7F) = 1
    ProcedureReturn M51Sfr(adr & $7F)
  EndIf
  ProcedureReturn M51SfrRead(adr)
EndProcedure

ProcedureRAM M51SfrWrite(adr.i, value.i)
  Protected k.i, v.i
  v = value & 255
  If adr = $E0
    M51A = v
  ElseIf adr = $D0
    M51PswSet(v)
  ElseIf adr = $F0
    M51B = v
  ElseIf adr = $81
    M51SP = v
  ElseIf adr = $82
    M51DPTR = (M51DPTR & $FF00) | v
  ElseIf adr = $83
    M51DPTR = (M51DPTR & $FF) | (v << 8)
  Else
    k = M51SfrKind(adr & $7F)
    If k = 1
      M51Sfr(adr & $7F) = v
      CompilerIf #M51_SFR_HOOK = 1
        M51HookSfrWrite(adr, v)
      CompilerEndIf
    ElseIf k = 3
      M51TimerSync()
      M51Sfr(adr & $7F) = v
      M51ForceExit()
    ElseIf k = 6
      M51Sfr($18) = v
      M51ForceExit()
    ElseIf k = 4
      ; The instruction after a write to IE or IP always runs before an
      ; interrupt is taken.
      M51Sfr(adr & $7F) = v
      M51IntHold = 1
      M51ForceExit()
    ElseIf k = 2
      M51Transmit(v)
    ElseIf k = 5
      M51Sfr($07) = v
      If v & 2
        M51PowerDown = 1
        M51ForceExit()
      ElseIf v & 1
        M51Idle = 1
        M51ForceExit()
      EndIf
    Else
      CompilerIf #M51_SFR_HOOK = 1
        M51HookSfrWrite(adr, v)
      CompilerElse
        M51Sfr(adr & $7F) = v
      CompilerEndIf
    EndIf
  EndIf
EndProcedure

; Bit space: 0-$7F are the bytes $20-$2F; $80-$FF are bit-addressable SFRs.
ProcedureRAM.i M51BitRead(b.i)
  If b < $80
    ProcedureReturn (M51IRam($20 + (b >> 3)) >> (b & 7)) & 1
  EndIf
  ProcedureReturn (M51SfrRead(b & $F8) >> (b & 7)) & 1
EndProcedure

ProcedureRAM.i M51BitReadLatch(b.i)
  If b < $80
    ProcedureReturn (M51IRam($20 + (b >> 3)) >> (b & 7)) & 1
  EndIf
  ProcedureReturn (M51SfrReadLatch(b & $F8) >> (b & 7)) & 1
EndProcedure

ProcedureRAM M51BitWrite(b.i, bit.i)
  Protected adr.i, mask.i, v.i
  mask = 1 << (b & 7)
  If b < $80
    adr = $20 + (b >> 3)
    If bit
      M51IRam(adr) = M51IRam(adr) | mask
    Else
      M51IRam(adr) = M51IRam(adr) & (~mask)
    EndIf
  Else
    adr = b & $F8
    v = M51SfrReadLatch(adr)
    If bit
      v = v | mask
    Else
      v = v & (~mask)
    EndIf
    M51SfrWrite(adr, v)
  EndIf
EndProcedure

; ---- interrupts --------------------------------------------------------------
; Polled between slices. Sources in their fixed order: IE0, TF0, IE1, TF1,
; RI/TI, TF2/EXF2. IP selects the high level; a high-level routine cannot be
; interrupted, a low-level one only by a high-level request.
ProcedureRAM.i M51IntPoll()
  Protected ie.i, req.i, tcon.i, hi.i, lvl.i, n.i, mask.i
  tcon = M51Sfr($08)
  ; Level-triggered INT0 / INT1: the flag follows the pin.
  If (tcon & 1) = 0
    If M51Int0Pin
      tcon = tcon & $FD
    Else
      tcon = tcon | 2
    EndIf
  EndIf
  If (tcon & 4) = 0
    If M51Int1Pin
      tcon = tcon & $F7
    Else
      tcon = tcon | 8
    EndIf
  EndIf
  M51Sfr($08) = tcon
  ie = M51Sfr($28)
  If (ie & $80) = 0
    ProcedureReturn 0
  EndIf
  If M51IntActive & 2
    ProcedureReturn 0
  EndIf
  req = 0
  If tcon & 2
    req = 1
  EndIf
  If tcon & $20
    req = req | 2
  EndIf
  If tcon & 8
    req = req | 4
  EndIf
  If tcon & $80
    req = req | 8
  EndIf
  If M51Sfr($18) & 3
    req = req | 16
  EndIf
  CompilerIf #M51_8052 = 1
    If M51Sfr($48) & $C0
      req = req | 32
    EndIf
  CompilerEndIf
  req = req & ie & $3F
  If req = 0
    ProcedureReturn 0
  EndIf
  hi = req & M51Sfr($38)
  If hi
    req = hi
    lvl = 2
  ElseIf M51IntActive = 0
    lvl = 1
  Else
    ProcedureReturn 0
  EndIf
  n = 0
  mask = 1
  While (req & mask) = 0
    n = n + 1
    mask = mask << 1
  Wend
  ; Hardware clears the timer flags and the edge-triggered external flags
  ; of the source it vectors to; RI, TI, TF2 and EXF2 stay for software.
  If n = 0
    If tcon & 1
      tcon = tcon & $FD
    EndIf
  ElseIf n = 1
    tcon = tcon & $DF
  ElseIf n = 2
    If tcon & 4
      tcon = tcon & $F7
    EndIf
  ElseIf n = 3
    tcon = tcon & $7F
  EndIf
  M51Sfr($08) = tcon
  M51Push(M51PC & 255)
  M51Push(M51PC >> 8)
  M51PC = 3 + (8 * n)
  M51IntActive = M51IntActive | lvl
  M51IntCount = M51IntCount + 1
  If M51Idle
    M51Idle = 0
    M51Sfr($07) = M51Sfr($07) & $FE
  EndIf
  ProcedureReturn 1
EndProcedure

; Executes whole instructions while the budget lasts. Each handler ends
; in its own copy of the dispatch tail; there is no call per instruction.
ProcedureRAM.i M51Slice(n.i)
  If M51Ready = 0
    For M51InitIndex = 0 To 255
      M51Dispatch(M51InitIndex) = ?Illegal
    Next
    M51Dispatch($00) = ?Op00
    M51Dispatch($01) = ?Op01
    M51Dispatch($02) = ?Op02
    M51Dispatch($03) = ?Op03
    M51Dispatch($04) = ?Op04
    M51Dispatch($05) = ?Op05
    M51Dispatch($06) = ?Op06
    M51Dispatch($07) = ?Op07
    M51Dispatch($08) = ?Op08
    M51Dispatch($09) = ?Op09
    M51Dispatch($0A) = ?Op0A
    M51Dispatch($0B) = ?Op0B
    M51Dispatch($0C) = ?Op0C
    M51Dispatch($0D) = ?Op0D
    M51Dispatch($0E) = ?Op0E
    M51Dispatch($0F) = ?Op0F
    M51Dispatch($10) = ?Op10
    M51Dispatch($11) = ?Op11
    M51Dispatch($12) = ?Op12
    M51Dispatch($13) = ?Op13
    M51Dispatch($14) = ?Op14
    M51Dispatch($15) = ?Op15
    M51Dispatch($16) = ?Op16
    M51Dispatch($17) = ?Op17
    M51Dispatch($18) = ?Op18
    M51Dispatch($19) = ?Op19
    M51Dispatch($1A) = ?Op1A
    M51Dispatch($1B) = ?Op1B
    M51Dispatch($1C) = ?Op1C
    M51Dispatch($1D) = ?Op1D
    M51Dispatch($1E) = ?Op1E
    M51Dispatch($1F) = ?Op1F
    M51Dispatch($20) = ?Op20
    M51Dispatch($21) = ?Op21
    M51Dispatch($22) = ?Op22
    M51Dispatch($23) = ?Op23
    M51Dispatch($24) = ?Op24
    M51Dispatch($25) = ?Op25
    M51Dispatch($26) = ?Op26
    M51Dispatch($27) = ?Op27
    M51Dispatch($28) = ?Op28
    M51Dispatch($29) = ?Op29
    M51Dispatch($2A) = ?Op2A
    M51Dispatch($2B) = ?Op2B
    M51Dispatch($2C) = ?Op2C
    M51Dispatch($2D) = ?Op2D
    M51Dispatch($2E) = ?Op2E
    M51Dispatch($2F) = ?Op2F
    M51Dispatch($30) = ?Op30
