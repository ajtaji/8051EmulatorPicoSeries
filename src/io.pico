; USB serial text helpers shared by the demo and the diagnostics.
Procedure Say(*text.i)
  Protected p.i, c.i
  p = *text
  c = PeekA(p) & 255
  While c
    UsbSerialWrite(c)
    p = p + 1
    c = PeekA(p) & 255
  Wend
EndProcedure
; The zero-terminated ASCII text at an address (a name in a DataSection).
Procedure SayAt(p.i)
  Say(p)
EndProcedure
Procedure Num(v.i)
  Protected d.i
  If v < 0
    UsbSerialWrite(45)
    v = 0 - v
  EndIf
  d = 1
  While v / d >= 10
    d = d * 10
  Wend
  While d > 0
    UsbSerialWrite(48 + ((v / d) % 10))
    d = d / 10
  Wend
EndProcedure
Procedure Hex2(v.i)
  Protected h.i
  h = (v >> 4) & 15
  If h < 10
    UsbSerialWrite(48 + h)
  Else
    UsbSerialWrite(55 + h)
  EndIf
  h = v & 15
  If h < 10
    UsbSerialWrite(48 + h)
  Else
    UsbSerialWrite(55 + h)
  EndIf
EndProcedure
Procedure Eol()
  UsbSerialWrite(13) : UsbSerialWrite(10)
  UsbSerialFlush() : UsbSerialTask()
EndProcedure
Procedure WaitUs(us.i)
  Protected t.i
  t = Micros()
  While Micros() - t < us
    UsbSerialTask() : SafetyPet()
  Wend
EndProcedure
; count * 1,000,000 / us without overflowing 32 bits.
Procedure.i Rate(count.i, us.i)
  Protected q.i, remainder.i, digit.i
  q = count / us : remainder = count % us
  For digit = 1 To 6
    remainder = remainder * 10
    q = (q * 10) + (remainder / us)
    remainder = remainder % us
  Next
  ProcedureReturn q
EndProcedure
