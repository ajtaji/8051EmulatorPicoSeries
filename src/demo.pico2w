; Pico 2 W demo: a smoke test, then four instruction mixes measured over and over.
#CLOCK_KHZ = 150000
#M51_TIMING = 0
#M51_ASM_TAIL = 1
#M51_8052 = 1
#M51_SFR_HOOK = 0
#M51_XDATA_HOOK = 0
#M51_CODE_HOOK = 0
#M51_SERIAL_HOOK = 0
EnableExplicit
XIncludeFile "RP2350/Lib/clocks.pico2"
XIncludeFile "RP2350/Lib/timer.pico2"
XIncludeFile "RP2350/Lib/uart.pico2"
XIncludeFile "RP2350/Lib/usb_serial.pico2"
XIncludeFile "RP2350/Lib/safety.pico2"
XIncludeFile "mcs51.pico2"
XIncludeFile "io.pico2"
XIncludeFile "demo_body.pico2"
